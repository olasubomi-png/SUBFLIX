# ======================
# SUBFLIX Environment Variables
# ======================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or real secrets to git.

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/subflix

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (will be used in next phase)
# AUTH_SECRET=generate-a-long-random-string-here

# Object Storage (future)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# Paystack (Phase 6)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
